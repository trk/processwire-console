{
  "name": "trk/processwire-console",
  "description": "A professional CLI tool for ProcessWire CMS.",
  "version": "0.2.2",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "processwire",
    "cli",
    "console",
    "migrations",
    "queue",
    "scheduler",
    "testing",
    "playwright",
    "pest"
  ],
  "homepage": "https://github.com/trk/processwire-console",
  "authors": [
    {
      "name": "Iskender Totoglu",
      "homepage": "https://github.com/trk"
    }
  ],
  "support": {
    "issues": "https://github.com/trk/processwire-console/issues",
    "source": "https://github.com/trk/processwire-console"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "laravel/prompts": "^0.3",
    "symfony/console": "^7.0 || ^8.0",
    "dragonmantank/cron-expression": "^3.6"
  },
  "suggest": {
    "fakerphp/faker": "Generate realistic sample data in database seeders."
  },
  "autoload": {
    "psr-4": {
      "Totoglu\\Console\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Totoglu\\Console\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
  },
  "bin": [
    "bin/wire"
  ],
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G"
  }
}
