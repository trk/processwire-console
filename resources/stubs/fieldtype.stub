<?php

declare(strict_types=1);

namespace ProcessWire;

/**
 * {{className}} Fieldtype
 *
 * {{summary}}
 */
class {{className}} extends Fieldtype
{
	/**
	 * @return array<string, mixed>
	 */
	public static function getModuleInfo(): array
	{
		return [
			'title' => '{{title}}',
			'version' => '0.0.1',
			'summary' => '{{summary}}',
			'installs' => 'Inputfield{{baseName}}',
		];
	}

	public function sanitizeValue(Page $page, Field $field, mixed $value): mixed
	{
		return $this->wire()->sanitizer->text((string) $value);
	}

	/**
	 * @return array<string, mixed>
	 */
	public function getDatabaseSchema(Field $field): array
	{
		$schema = parent::getDatabaseSchema($field);
		$len = $this->wire()->database->getMaxIndexLength();
		$schema['data'] = 'text NOT NULL';
		$schema['keys']['data_exact'] = "KEY `data_exact` (`data`({$len}))";
		$schema['keys']['data'] = 'FULLTEXT KEY `data` (`data`)';
		return $schema;
	}

	public function ___savePageField(Page $page, Field $field): bool
	{
		return parent::___savePageField($page, $field);
	}

	public function ___loadPageField(Page $page, Field $field): mixed
	{
		return parent::___loadPageField($page, $field);
	}

	public function getInputfield(Page $page, Field $field): ?Inputfield
	{
		/** @var Inputfield|null $inputfield */
		$inputfield = $this->wire()->modules->get('Inputfield{{baseName}}');
		return $inputfield;
	}
}
