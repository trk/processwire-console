<?php

declare(strict_types=1);

namespace ProcessWire;

return new class {

	private string $moduleName = '{{name}}';

	public function up(): void
	{
		$modules = wire('modules');
		$modules->refresh();

		if (!$modules->isInstallable($this->moduleName)) {
			throw new \RuntimeException("Module '{$this->moduleName}' is not installable. Ensure it exists in site/modules/.");
		}

		$installed = $modules->install($this->moduleName);
		if ($installed === null || !$modules->isInstalled($this->moduleName)) {
			throw new \RuntimeException("Failed to install module '{$this->moduleName}'.");
		}
	}

	public function down(): void
	{
		$modules = wire('modules');

		if (!$modules->isInstalled($this->moduleName)) {
			return;
		}

		$reason = $modules->isUninstallable($this->moduleName, true);
		if ($reason !== true) {
			$detail = is_string($reason) && $reason !== '' ? $reason : 'Module is not uninstallable.';
			throw new WireException("Cannot uninstall module '{$this->moduleName}': {$detail}");
		}

		$modules->uninstall($this->moduleName);
	}
};
