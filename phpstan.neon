parameters:
	phpVersion: 80300
	level: 8
	treatPhpDocTypesAsCertain: false
	reportUnmatchedIgnoredErrors: false
	paths:
		- src
		- bin/wire
		- tests
	tmpDir: .phpstan.cache
	ignoreErrors:
		- '#(Used )?[Ff]unction ProcessWire\\wire not found#'
		- '#Instantiated class ProcessWire\\[A-Za-z0-9_\\]+ not found#'
		- '#has invalid (return )?type ProcessWire\\[A-Za-z0-9_\\]+#'
		- '#has unknown class ProcessWire\\[A-Za-z0-9_\\]+ as its type#'
		- '#on an unknown class ProcessWire\\[A-Za-z0-9_\\]+#'
		- '#Class ProcessWire\\[A-Za-z0-9_\\]+ not found#'
